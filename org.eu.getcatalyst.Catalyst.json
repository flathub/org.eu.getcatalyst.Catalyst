{
    "app-id": "org.eu.getcatalyst.Catalyst",
    "base": "org.electronjs.Electron2.BaseApp",
    "base-version": "25.08",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "run.sh",
    "separate-locales": false,
    "rename-desktop-file": "catalyst.desktop",
    "rename-icon": "icon-512x512",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri"
    ],
    "modules": [
        {
            "name": "catalyst",
            "buildsystem": "simple",
            "build-commands": [
                "ar x catalyst.deb",
                "tar -xf data.tar.xz",
                "cp -r usr/* /app/",
                "cp -r opt/ /app/",
                "install -Dm644 icon-512x512.png -t /app/share/icons/hicolor/512x512/apps/",
                "install -Dm644 org.eu.getcatalyst.Catalyst.appdata.xml -t /app/share/metainfo/",
                "desktop-file-edit --set-name=Catalyst ${FLATPAK_DEST}/share/applications/catalyst.desktop",
                "desktop-file-edit --set-key=Exec --set-value=/app/bin/run.sh ${FLATPAK_DEST}/share/applications/catalyst.desktop",
                "install -Dm755 run.sh -t /app/bin/"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/CatalystDevOrg/Catalyst/1b99f30773bdfe9a0453dece38683059b0c55c6f/assets/icon-512x512.png",
                    "sha256": "2fba9fe630a0de3a9d04a8978158ad53edde42a61ed7bbe58be91bb65bca062a"
                },
                {
                    "type": "file",
                    "url": "https://github.com/CatalystDevOrg/Catalyst/releases/download/v3.9.6/catalyst_3.9.6_amd64.deb",
                    "sha256": "d3a5e2f04d05dd72d5e508bbbca85219374413391d2f6677f68ce2abb32dc8e6",
                    "dest-filename": "catalyst.deb"
                },
                {
                    "type": "file",
                    "path": "org.eu.getcatalyst.Catalyst.appdata.xml"
                },
                {
                    "type": "script",
                    "dest-filename": "run.sh",
                    "commands": [
                        "zypak-wrapper /app/opt/catalyst/catalyst --ozone-platform-hint=auto"
                    ]
                }
            ]
        }
    ]
}
